<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jin 기출 archive</title>
    <link rel="icon" type="image/png" href="data:image/png;base64,">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Pretendard Font -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'Roboto', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* 사이트 로고 (이미지를 파일 안에 직접 넣어 GitHub Pages에 index.html 하나만 올려도 표시됨) */
        .app-logo {
            background: #ffffff url("data:image/png;base64,") center / 88% no-repeat;
        }
        body {
            background-color: #f8fafc;
            color: #0f172a;
            overflow-x: hidden;
        }
        .fade-in {
            animation: fadeIn 0.22s ease-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">

    <!-- ================= [전체 화면 로그인 게이트 (로그인 전에는 이 화면만 노출)] ================= -->
    <div id="authGateView" class="min-h-screen flex-1 flex flex-col justify-center items-center px-4 py-10 bg-gradient-to-br from-slate-900 via-brand-900 to-slate-900 text-slate-900 relative overflow-hidden">
        <!-- 배경 장식 요소 -->
        <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-brand-500/20 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-indigo-500/20 blur-3xl pointer-events-none"></div>

        <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-white/20 p-6 sm:p-8 space-y-6 relative z-10 fade-in">
            <!-- 상단 브랜드 헤더 -->
            <div class="text-center space-y-2">
                <div class="app-logo w-20 h-20 rounded-2xl border border-slate-200 mx-auto shadow-lg shadow-brand-500/20" role="img" aria-label="Jin 기출 archive 로고"></div>
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-brand-50 text-brand-700 border border-brand-200/60">
                    <i class="ph-fill ph-graduation-cap"></i> 원광대학교 의과대학
                </div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Jin 기출 archive</h1>
                <p class="text-xs text-slate-500 leading-relaxed">
                    처음 로그인 시 관리자에게 <b class="text-slate-700">가입 승인 요청</b>이 전달되며,<br>
                    관리자 승인 완료 후 기출문제 열람 및 학습이 가능합니다.
                </p>
            </div>

            <!-- 승인 대기 안내 알림 박스 (승인 대기 상태일 때만 노출) -->
            <div id="pendingNoticeBox" class="hidden rounded-2xl bg-amber-50 border border-amber-200 p-4 space-y-2 text-left">
                <div class="flex items-start gap-2.5">
                    <i class="ph-fill ph-clock-countdown text-amber-600 text-xl shrink-0 mt-0.5"></i>
                    <div class="space-y-1">
                        <p id="pendingNoticeTitle" class="text-xs font-extrabold text-amber-900">관리자 승인 대기 중인 계정입니다.</p>
                        <p id="pendingNoticeDesc" class="text-[11px] text-amber-800 leading-relaxed">
                            관리자가 회원 승인을 완료하면 접속하실 수 있습니다.
                        </p>
                    </div>
                </div>
            </div>

            <!-- 최근 로그인한 계정 빠른 선택 영역 -->
            <div id="recentUsersSection" class="hidden space-y-2 pt-1">
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-extrabold text-slate-500">이 기기에서 최근 로그인한 계정</span>
                    <button type="button" onclick="app.clearRecentUsers()" class="text-[11px] font-semibold text-slate-400 hover:text-rose-600">목록 지우기</button>
                </div>
                <div id="recentUsersList" class="flex flex-wrap gap-1.5">
                    <!-- JS로 최근 계정 칩 렌더링 -->
                </div>
            </div>

            <!-- 학번 / 이름 로그인 폼 -->
            <form onsubmit="app.loginFromGate(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-extrabold text-slate-700 mb-1.5">학번 또는 아이디 *</label>
                    <div class="relative">
                        <i class="ph-bold ph-identification-badge absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="gateUserIdInput" oninput="app.onGateIdInputChange(this.value)" required placeholder="예: 20240101" autocomplete="username" class="w-full pl-10 pr-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl outline-none focus:bg-white focus:border-brand-600 transition-colors">
                    </div>
                </div>

                <div id="gateUserNameWrapper">
                    <label class="block text-xs font-extrabold text-slate-700 mb-1.5">이름 (실명 또는 닉네임) *</label>
                    <div class="relative">
                        <i class="ph-bold ph-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="gateUserNameInput" placeholder="예: 홍길동" class="w-full pl-10 pr-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl outline-none focus:bg-white focus:border-brand-600 transition-colors">
                    </div>
                </div>

                <!-- 관리자 아이디를 입력했을 때만 나타나는 비밀번호 입력칸 (안내 문구 없음) -->
                <div id="gateAdminPasswordWrapper" class="hidden">
                    <label class="block text-xs font-extrabold text-slate-700 mb-1.5">비밀번호 *</label>
                    <div class="relative">
                        <i class="ph-bold ph-lock-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="password" id="gateAdminPasswordInput" placeholder="비밀번호 입력" autocomplete="current-password" class="w-full pl-10 pr-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl outline-none focus:bg-white focus:border-brand-600 transition-colors">
                    </div>
                </div>

                <button type="submit" id="gateSubmitBtn" class="w-full py-3 rounded-xl text-sm font-extrabold bg-brand-600 hover:bg-brand-700 text-white shadow-md shadow-brand-600/20 transition-all flex items-center justify-center gap-2">
                    <i class="ph-bold ph-sign-in text-lg"></i>
                    <span id="gateSubmitBtnText">로그인 / 가입 승인 요청하기</span>
                </button>
            </form>

            <!-- 구분선 -->
            <div class="relative flex py-0.5 items-center">
                <div class="flex-grow border-t border-slate-200"></div>
                <span class="flex-shrink mx-3 text-[11px] font-semibold text-slate-400">외부 소셜 로그인</span>
                <div class="flex-grow border-t border-slate-200"></div>
            </div>

            <!-- Google 계정 로그인 -->
            <div class="space-y-2.5">
                <button type="button" onclick="app.loginWithGoogle()" class="w-full py-2.5 px-4 rounded-xl border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-colors">
                    <i class="ph-bold ph-google-logo text-rose-500 text-base"></i>
                    <span>Google 계정으로 로그인</span>
                </button>
            </div>
        </div>

        <p class="text-xs text-slate-400 mt-6 relative z-10 text-center">
            🔒 비로그인 사용자의 문제 열람 및 무단 배포가 제한되어 있습니다.
        </p>
    </div>

    <!-- ================= 상단 네비게이션 헤더 (로그인 시에만 표시) ================= -->
    <header id="appHeader" class="hidden bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2">
            <!-- 로고 및 타이틀 -->
            <div class="flex items-center gap-3 cursor-pointer shrink-0" onclick="app.switchMainTab('USER')">
                <div class="app-logo w-11 h-11 rounded-xl border border-slate-200 shadow-xs shrink-0" role="img" aria-label="Jin 기출 archive 로고"></div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-extrabold text-base sm:text-lg text-slate-900 tracking-tight leading-none">Jin 기출 archive</h1>
                        <span id="cloudStatusBadge" class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 동기화 활성
                        </span>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-1 hidden sm:block">학년 · 과목 · 기출학번 맞춤형 학습 & 클라우드 오답노트</p>
                </div>
            </div>

            <!-- 중앙 모드 전환 탭 (오직 admin 계정으로 로그인했을 때만 노출, 일반 사용자에게는 완전히 숨김) -->
            <div id="adminModeSwitchBar" class="hidden items-center bg-slate-100 p-1 rounded-xl border border-slate-200/80">
                <button id="tabBtnAdmin" onclick="app.switchMainTab('ADMIN')" class="inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all bg-white text-brand-700 shadow-xs">
                    <i class="ph-bold ph-shield-star text-base text-amber-500"></i>
                    <span>관리자 센터</span>
                    <span id="headerPendingCountBadge" class="hidden px-1.5 py-0.2 rounded-full text-[10px] font-extrabold bg-rose-600 text-white">0</span>
                </button>
                <button id="tabBtnUser" onclick="app.switchMainTab('USER')" class="inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition-all">
                    <i class="ph-bold ph-book-open-text text-base"></i>
                    <span>학습 화면 미리보기</span>
                </button>
            </div>

            <!-- 우측 사용자 프로필 & 로그아웃/클라우드 설정 버튼 -->
            <div class="flex items-center gap-2 shrink-0">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50">
                    <div id="userAvatar" class="w-7 h-7 rounded-full bg-brand-600 text-white font-bold text-xs flex items-center justify-center">
                        U
                    </div>
                    <div class="text-left hidden md:block">
                        <p id="userNameDisplay" class="text-xs font-bold text-slate-800 leading-none">로그인 사용자</p>
                        <p id="userSubDisplay" class="text-[10px] text-slate-500 mt-0.5">승인 완료</p>
                    </div>
                </div>

                <button onclick="app.logout()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-extrabold transition-colors" title="로그아웃 후 화면 잠금">
                    <i class="ph-bold ph-sign-out text-sm"></i>
                    <span class="hidden sm:inline">로그아웃</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ================= 메인 컨텐츠 컨테이너 (로그인 시에만 표시) ================= -->
    <main id="appMain" class="hidden flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

        <!-- ======================================================================= -->
        <!-- [VIEW 1] 학습자 메인 대시보드 (진행 상황 + 학년 > 과목 > 기출학번 선택) -->
        <!-- ======================================================================= -->
        <section id="userDashboardView" class="space-y-6 fade-in">

            <!-- 1. 내 진행 상황 요약 -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <div class="lg:col-span-2 bg-gradient-to-br from-brand-600 to-indigo-700 text-white rounded-2xl p-5 sm:p-6 shadow-md space-y-4">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="space-y-1">
                            <span id="dashboardUserBadge" class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-white/15 border border-white/20">개인 학습 현황</span>
                            <h2 class="text-lg sm:text-xl font-extrabold">전체 기출 진도율</h2>
                        </div>
                        <button onclick="app.confirmResetUserProgress()" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-[11px] font-bold bg-white/10 hover:bg-white/20 transition-colors">
                            <i class="ph-bold ph-arrow-counter-clockwise"></i> 내 기록 초기화
                        </button>
                    </div>
                    <div class="flex items-end gap-3 flex-wrap">
                        <span id="totalProgressPercent" class="text-4xl sm:text-5xl font-extrabold leading-none">0%</span>
                        <span id="totalProgressFraction" class="text-sm font-semibold text-white/80 pb-1">(0 / 0 문제)</span>
                        <span id="totalUnderstoodCount" class="ml-auto text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-400/20 text-emerald-100 border border-emerald-300/30">0문제 완벽 이해</span>
                    </div>
                    <div class="w-full h-2.5 bg-white/20 rounded-full overflow-hidden">
                        <div id="totalProgressBar" class="h-full bg-white rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs">
                        <p class="text-[11px] font-bold text-slate-500">등록 문제</p>
                        <p id="statAllCount" class="text-2xl font-extrabold text-slate-900 mt-1">0</p>
                    </div>
                    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs">
                        <p class="text-[11px] font-bold text-slate-500">내가 푼 문제</p>
                        <p id="statMySolved" class="text-2xl font-extrabold text-brand-700 mt-1">0</p>
                    </div>
                    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs">
                        <p class="text-[11px] font-bold text-slate-500">정답률</p>
                        <p id="statMyAccuracy" class="text-2xl font-extrabold text-emerald-600 mt-1">0%</p>
                    </div>
                    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs">
                        <p class="text-[11px] font-bold text-slate-500">복습 필요</p>
                        <p id="statMyReview" class="text-2xl font-extrabold text-rose-600 mt-1">0</p>
                    </div>
                </div>
            </div>

            <!-- 2. Step 1 학년 선택 -->
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs space-y-3">
                <div class="flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-brand-600 text-white text-xs font-extrabold flex items-center justify-center">1</span>
                    <h3 class="font-extrabold text-sm sm:text-base text-slate-900">학년 선택</h3>
                </div>
                <div id="step1GradeContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5"></div>
            </div>

            <!-- 3. Step 2 과목 선택 -->
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs space-y-3">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-indigo-600 text-white text-xs font-extrabold flex items-center justify-center">2</span>
                        <h3 class="font-extrabold text-sm sm:text-base text-slate-900">과목 선택</h3>
                    </div>
                    <span id="step2HelperText" class="text-[11px] font-semibold text-slate-500"></span>
                </div>
                <div id="step2SubjectContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
            </div>

            <!-- 4. Step 3 기출 학번 선택 -->
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs space-y-3">
                <div class="flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-amber-500 text-white text-xs font-extrabold flex items-center justify-center">3</span>
                    <h3 class="font-extrabold text-sm sm:text-base text-slate-900">기출 학번 선택</h3>
                </div>
                <div id="step3CohortContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5"></div>
            </div>

            <!-- 5. 선택된 세트 & 풀이 모드 -->
            <div class="bg-slate-900 text-white rounded-2xl p-5 sm:p-6 shadow-md space-y-4">
                <div class="space-y-1.5">
                    <div id="selectionBreadcrumb" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-300 flex-wrap"></div>
                    <h3 id="selectedTargetTitle" class="text-base sm:text-lg font-extrabold">🎯 선택된 기출 세트</h3>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5">
                    <button onclick="app.startFilteredQuiz('ALL')" class="p-3.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-left transition-colors">
                        <div class="flex items-center gap-1.5 text-sm font-extrabold"><i class="ph-bold ph-play-circle text-lg"></i>전체 풀이</div>
                        <p id="modeCountAll" class="text-[11px] font-semibold text-white/75 mt-1">0문제</p>
                    </button>
                    <button onclick="app.startFilteredQuiz('UNSOLVED')" class="p-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-left transition-colors">
                        <div class="flex items-center gap-1.5 text-sm font-extrabold"><i class="ph-bold ph-circle-dashed text-lg"></i>안 푼 문제</div>
                        <p id="modeCountUnsolved" class="text-[11px] font-semibold text-white/60 mt-1">0문제</p>
                    </button>
                    <button onclick="app.startFilteredQuiz('WRONG_OR_BOOKMARK')" class="p-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-left transition-colors">
                        <div class="flex items-center gap-1.5 text-sm font-extrabold"><i class="ph-bold ph-bookmark-simple text-lg text-amber-300"></i>오답 & 오답노트</div>
                        <p id="modeCountWrong" class="text-[11px] font-semibold text-white/60 mt-1">0문제</p>
                    </button>
                    <button onclick="app.startFilteredQuiz('NOT_UNDERSTOOD')" class="p-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-left transition-colors">
                        <div class="flex items-center gap-1.5 text-sm font-extrabold"><i class="ph-bold ph-lightbulb text-lg text-emerald-300"></i>해설 미숙지</div>
                        <p id="modeCountNotUnderstood" class="text-[11px] font-semibold text-white/60 mt-1">0문제</p>
                    </button>
                </div>
            </div>

            <!-- 6. 문제 미리보기 리스트 -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
                <div class="px-5 sm:px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                    <h3 class="font-bold text-sm sm:text-base text-slate-900">문제 목록 (클릭하면 해당 문제부터 풀이)</h3>
                    <span id="previewListCountBadge" class="text-xs font-extrabold text-brand-700 bg-brand-50 px-2.5 py-0.5 rounded-full">총 0문항</span>
                </div>
                <div id="userQuestionPreviewList" class="divide-y divide-slate-100"></div>
            </div>
        </section>

        <!-- ======================================================================= -->
        <!-- [VIEW 2] 퀴즈 풀이 화면 -->
        <!-- ======================================================================= -->
        <section id="quizSolveView" class="hidden space-y-4 fade-in">
            <!-- 상단 바 -->
            <div class="flex flex-wrap items-center justify-between gap-3">
                <button onclick="app.exitQuizToDashboard()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
                    <i class="ph-bold ph-arrow-left"></i> 대시보드로
