                cohort: '23학번 기출',
                question: '갑작스러운 흉통으로 내원한 58세 남성 환자의 심전도(ECG)에서 Lead II, III, aVF에서 ST 분절 상승(ST elevation)이 관찰되었다. 가장 의심되는 심근경색 부위와 원인 혈관은?',
                options: [
                    '앞벽 심근경색(Anterior MI) - 앞심실사이가지(LAD)',
                    '아래벽 심근경색(Inferior MI) - 오른관상동맥(RCA)',
                    '가쪽벽 심근경색(Lateral MI) - 휘돌이가지(LCX)',
                    '뒤벽 심근경색(Posterior MI) - 왼관상동맥 주간부(LMCA)',
                    '심실중격 단독 경색 - 대각가지(Diagonal branch)'
                ],
                answer: 2,
                explanation: '심전도에서 Lead II, III, aVF는 심장의 아래벽(Inferior wall)을 반영하는 유도입니다. 해당 유도에서 ST 분절 상승이 나타나면 아래벽 ST절 상승 심근경색(Inferior STEMI)을 진단하며, 주된 원인 혈관은 오른관상동맥(RCA, 약 80~85%)입니다.'
            },
            {
                id: 'q_med_202',
                grade: '본과 2학년',
                subject: '순환기학',
                cohort: '22학번 기출',
                question: '박출률 감소 심부전(HFrEF) 환자에서 생존율을 유의하게 개선시켜 사망률을 낮추는 것으로 입증된 표준 약제(GDMT)에 해당하지 않는 것은?',
                options: [
                    '안지오텐신 수용체-네프릴리신 억제제 (ARNI) 또는 ACE 억제제',
                    '베타차단제 (Bisoprolol, Carvedilol, Metoprolol succinate)',
                    '염류코르티코이드 수용체 길항제 (Spironolactone)',
                    'SGLT2 억제제 (Dapagliflozin, Empagliflozin)',
                    '비디히드로피리딘계 칼슘채널차단제 (Verapamil, Diltiazem)'
                ],
                answer: 5,
                explanation: 'HFrEF의 4대 핵심 생존율 개선 약제(Fantastic 4)는 ARNI(또는 ACEi/ARB), 베타차단제, MRA(Spironolactone), SGLT2 억제제입니다. 반면 Verapamil이나 Diltiazem 같은 Non-DHP CCB는 음성 수축력 효과(Negative inotropic effect)로 인해 심부전을 악화시킬 수 있어 금기입니다.'
            },
            {
                id: 'q_med_203',
                grade: '본과 2학년',
                subject: '호흡기학',
                cohort: '23학번 기출',
                question: '기관지확장제 투여 후 폐기능검사(Spirometry)에서 FEV1/FVC < 0.70 이면서 가역성이 없는 만성폐쇄성폐질환(COPD) 환자의 폐용적 변화 특징으로 옳은 것은?',
                options: [
                    '잔기량(RV) 감소 및 총폐용량(TLC) 감소',
                    '기능적잔기량(FRC) 감소 및 예비호기량(ERV) 증가',
                    '공기걸림(Air trapping)으로 인한 잔기량(RV) 및 기능적잔기량(FRC) 증가',
                    '노력성폐활량(FVC)의 현저한 증가와 폐탄성 반동력 증가',
                    '일산화탄소 확산능(DLCO)의 비정상적 상승'
                ],
                answer: 3,
                explanation: 'COPD(특히 폐기종)에서는 폐포벽 파괴로 인해 폐 탄성 반동력이 감소하고 호기 시 기도가 조기에 폐쇄되어 공기걸림(Air trapping)과 폐 과팽창(Hyperinflation)이 발생합니다. 그 결과 잔기량(RV), 기능적잔기량(FRC), 총폐용량(TLC)이 모두 증가합니다.'
            }
        ];

        const app = {
            // 데이터 상태
            questions: [],
            // 로그인 전에는 null 상태를 유지하여 전체 화면 로그인 게이트가 작동하도록 설정
            currentUser: null,
            recentUsers: [],
            // 회원 가입/승인 레지스트리 맵: { [uid]: { uid, name, status: 'PENDING' | 'APPROVED' | 'REJECTED', requestedAt } }
            userRegistryMap: {},
            // 사용자별 풀이 기록 맵: { [uid]: { [questionId]: { solved, isCorrect, userChoice, understood, bookmarked } } }
            allUsersProgressMap: {},

            // 3단계 계층 선택 상태 (학년 -> 과목 -> 기출학번)
            selectedGrade: null,
            selectedSubject: null,
            selectedCohort: 'ALL',

            // 현재 진행 중인 퀴즈 상태
            quizQueue: [],
            currentQuizIdx: 0,
            currentQuizModeName: '전체 풀이',

            // 관리자 인증 상태 (관리자 아이디 + 비밀번호로 로그인했을 때만 true)
            isAdminUnlocked: false,
            isAdminUiMounted: false,

            // Firebase 인스턴스
            fbApp: null,
            fbDb: null,
            fbAuth: null,
            appId: 'exam-master-pro',
            isCloudConnected: false,

            async init() {
                this.loadLocalData();
                await this.initFirebaseIfAvailable();
                this.ensureDefaultHierarchySelection();
                this.bindKeyboardEvents();
                this.renderAll();
                if (this.currentUser && this.currentUser.isAdmin) {
                    this.switchMainTab('ADMIN');
                }
            },

            // ================= [관리자 권한 / 비밀번호 / 세션] =================
            getAdminPasswordHash() {
                try {
                    // 구버전(평문 저장) 비밀번호가 있으면 해시로 이전하고 평문은 삭제
                    const legacy = localStorage.getItem(STORAGE_KEYS.ADMIN_PIN);
                    if (legacy) {
                        localStorage.setItem(STORAGE_KEYS.ADMIN_HASH, sha256Hex(legacy));
                        localStorage.removeItem(STORAGE_KEYS.ADMIN_PIN);
                    }
                    return localStorage.getItem(STORAGE_KEYS.ADMIN_HASH) || ADMIN_PASSWORD_HASH;
                } catch (e) {
                    return ADMIN_PASSWORD_HASH;
                }
            },

            // 관리자 세션은 localStorage에 isAdmin 플래그로 저장하지 않고,
            // sessionStorage에 '현재 비밀번호 해시 기반 토큰'으로만 보관합니다.
            // (비밀번호가 바뀌면 기존 세션은 자동 무효)
            makeAdminSessionToken() {
                return sha256Hex('admin-session:' + this.getAdminPasswordHash());
            },

            hasValidAdminSession() {
                try {
                    return sessionStorage.getItem(STORAGE_KEYS.ADMIN_SESSION) === this.makeAdminSessionToken();
                } catch (e) {
                    return false;
                }
            },

            // 관리자 전용 기능 호출 전 권한 확인 (콘솔에서 직접 호출하는 것도 차단)
            requireAdmin() {
                if (this.currentUser && this.currentUser.isAdmin && this.isAdminUnlocked && this.isAdminUiMounted) {
                    return true;
                }
                this.showToast('권한이 없습니다.', 'error');
                return false;
            },

            // 관리자 로그인 시에만 템플릿을 복제해 관리자 화면/모달을 DOM에 생성
            mountAdminUI() {
                if (this.isAdminUiMounted) return;
                const tpl = document.getElementById('adminUiTemplate');
                if (!tpl) return;
                const frag = tpl.content.cloneNode(true);
                const mainEl = document.getElementById('appMain');
                const anchor = document.getElementById('confirmDialogModal');
                Array.from(frag.children).forEach(el => {
                    el.setAttribute('data-admin-ui', '1');
                    if (el.id === 'adminPageView') {
                        mainEl.appendChild(el);
                    } else {
                        document.body.insertBefore(el, anchor);
                    }
                });
                this.isAdminUiMounted = true;
            },

            // 로그아웃 시 관리자 화면/모달을 DOM에서 완전히 제거
            unmountAdminUI() {
                document.querySelectorAll('[data-admin-ui]').forEach(el => el.remove());
                this.isAdminUiMounted = false;
            },

            setViewVisible(id, visible) {
                const el = document.getElementById(id);
                if (el) el.classList.toggle('hidden', !visible);
            },

            // 로컬 스토리지 데이터 로드
            loadLocalData() {
                try {
                    const savedQ = localStorage.getItem(STORAGE_KEYS.QUESTIONS);
                    if (savedQ) {
                        const parsed = JSON.parse(savedQ);
                        if (Array.isArray(parsed) && parsed.length > 0) {
                            this.questions = parsed;
                        }
                    }
                    if (this.questions.length === 0) {
                        this.questions = JSON.parse(JSON.stringify(INITIAL_SAMPLE_QUESTIONS));
                        this.saveQuestionsToLocal();
                    }

                    const savedRecent = localStorage.getItem(STORAGE_KEYS.RECENT_USERS);
                    if (savedRecent) {
                        // 관리자 계정은 '최근 로그인 계정' 목록에 노출하지 않음
                        this.recentUsers = (JSON.parse(savedRecent) || []).filter(u => u && !isAdminId(u.uid));
                    }

                    const savedRegistry = localStorage.getItem(STORAGE_KEYS.USER_REGISTRY);
                    if (savedRegistry) {
                        this.userRegistryMap = JSON.parse(savedRegistry) || {};
                    }

                    const savedMap = localStorage.getItem(STORAGE_KEYS.USER_PROFILES);
                    if (savedMap) {
                        this.allUsersProgressMap = JSON.parse(savedMap);
                    }

                    // 1) 관리자 세션: sessionStorage 토큰이 유효할 때만 복원 (localStorage의 isAdmin 값은 신뢰하지 않음)
                    if (this.hasValidAdminSession()) {
                        this.currentUser = { uid: ADMIN_ID, name: '총괄 관리자', isAdmin: true, authType: 'ADMIN' };
                        this.isAdminUnlocked = true;
                    } else {
                        // 2) 일반 사용자 세션: 현재 승인 상태가 'APPROVED'인 경우에만 유지
                        const savedUser = localStorage.getItem(STORAGE_KEYS.CURRENT_USER);
                        const parsedUser = savedUser ? JSON.parse(savedUser) : null;
                        if (parsedUser && parsedUser.uid && !isAdminId(parsedUser.uid)) {
                            const reg = this.userRegistryMap[parsedUser.uid];
                            if (reg && reg.status === 'APPROVED') {
                                this.currentUser = { uid: parsedUser.uid, name: parsedUser.name, isAdmin: false, authType: parsedUser.authType };
                            }
                        }
                        this.isAdminUnlocked = false;
                    }
                } catch (e) {
                    console.error('로컬 데이터 초기화 오류:', e);
                    this.questions = JSON.parse(JSON.stringify(INITIAL_SAMPLE_QUESTIONS));
                }
            },

            saveQuestionsToLocal() {
                try {
                    localStorage.setItem(STORAGE_KEYS.QUESTIONS, JSON.stringify(this.questions));
                } catch (e) {
                    console.error(e);
                }
            },

            saveUserRegistryToLocal() {
                try {
                    localStorage.setItem(STORAGE_KEYS.USER_REGISTRY, JSON.stringify(this.userRegistryMap));
                } catch (e) {
                    console.error(e);
                }
            },

            saveProgressToLocal() {
                try {
                    localStorage.setItem(STORAGE_KEYS.USER_PROFILES, JSON.stringify(this.allUsersProgressMap));
                    if (this.currentUser && !this.currentUser.isAdmin) {
                        localStorage.setItem(STORAGE_KEYS.CURRENT_USER, JSON.stringify(this.currentUser));
                    } else {
                        localStorage.removeItem(STORAGE_KEYS.CURRENT_USER);
                    }
                    localStorage.setItem(STORAGE_KEYS.RECENT_USERS, JSON.stringify(this.recentUsers));
                } catch (e) {
                    console.error(e);
                }
            },

            addRecentUser(userObj) {
                if (!userObj || !userObj.uid || isAdminId(userObj.uid)) return;
                this.recentUsers = [
                    userObj,
                    ...this.recentUsers.filter(u => u.uid !== userObj.uid)
                ].slice(0, 5);
                this.saveProgressToLocal();
            },

            clearRecentUsers() {
                this.recentUsers = [];
                localStorage.removeItem(STORAGE_KEYS.RECENT_USERS);
                this.renderAuthGate();
                this.showToast('최근 로그인 계정 목록을 지웠습니다.', 'info');
            },

            // Firebase 연동 초기화 (환경변수 또는 사용자 입력 Config 지원)
            async initFirebaseIfAvailable() {
                try {
                    let config = null;
                    if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                        config = JSON.parse(__firebase_config);
                    } else if (FIREBASE_CONFIG && FIREBASE_CONFIG.apiKey) {
                        config = FIREBASE_CONFIG;
                    } else {
                        const customRaw = localStorage.getItem(STORAGE_KEYS.CUSTOM_FB);
                        if (customRaw) config = JSON.parse(customRaw);
                    }

                    if (typeof __app_id !== 'undefined' && __app_id) {
                        this.appId = __app_id;
                    }

                    if (!config || !config.apiKey || this.fbApp) return;

                    this.fbApp = initializeApp(config);
                    this.fbAuth = getAuth(this.fbApp);
                    this.fbDb = getFirestore(this.fbApp);

                    // RULE 3: Auth Before Queries
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(this.fbAuth, __initial_auth_token);
                    } else {
                        await signInAnonymously(this.fbAuth);
                    }

                    if (this.fbAuth.currentUser) {
                        this.isCloudConnected = true;
                        document.getElementById('cloudStatusBadge').classList.remove('hidden');
                        this.setupFirestoreListeners();
                    }
                } catch (e) {
                    console.warn('클라우드 연동 대신 로컬 멀티 프로필 모드로 동작합니다:', e);
                }
            },

            setupFirestoreListeners() {
                if (!this.isCloudConnected || !this.fbAuth.currentUser) return;

                // 1. 공용 기출문제 컬렉션 실시간 구독 (RULE 1 준수)
                const qColRef = collection(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'questions');
                onSnapshot(qColRef, (snapshot) => {
                    if (!snapshot.empty) {
                        const cloudQuestions = [];
                        snapshot.forEach(docSnap => cloudQuestions.push(docSnap.data()));
                        this.questions = cloudQuestions;
                        this.saveQuestionsToLocal();
                        this.ensureDefaultHierarchySelection();
                        this.renderAll();
                    } else if (this.questions.length > 0) {
                        this.questions.forEach(q => this.syncSingleQuestionToCloud(q));
                    }
                }, (err) => console.warn('Firestore questions listener error:', err));

                // 2. 회원 승인 레지스트리 실시간 구독
                const regColRef = collection(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'userRegistry');
                onSnapshot(regColRef, (snapshot) => {
                    if (!snapshot.empty) {
                        const nextMap = { ...this.userRegistryMap };
                        snapshot.forEach(docSnap => {
                            const d = docSnap.data();
                            if (d && d.uid) nextMap[d.uid] = d;
                        });
                        this.userRegistryMap = nextMap;
                        this.saveUserRegistryToLocal();

                        // 만약 현재 로그인된 일반 사용자가 관리자에 의해 승인 취소된 경우 즉시 로그아웃 처리
                        if (this.currentUser && !this.currentUser.isAdmin) {
                            const myReg = this.userRegistryMap[this.currentUser.uid];
                            if (!myReg || myReg.status !== 'APPROVED') {
                                this.logout('관리자에 의해 계정 승인 상태가 변경되어 로그아웃되었습니다.');
                                return;
                            }
                        }
                        this.renderAll();
                    }
                }, (err) => console.warn('Firestore userRegistry listener error:', err));

                // 3. 현재 사용자의 개인 풀이 기록 구독
                this.loadCurrentUserProgressFromCloud();
            },

            async syncUserAccountToCloud(accountObj) {
                if (!this.isCloudConnected || !this.fbAuth.currentUser || !accountObj || !accountObj.uid) return;
                try {
                    const docRef = doc(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'userRegistry', accountObj.uid);
                    await setDoc(docRef, accountObj);
                } catch (e) {
                    console.warn('회원 승인 정보 클라우드 동기화 오류:', e);
                }
            },

            async deleteUserAccountFromCloud(uid) {
                if (!this.isCloudConnected || !this.fbAuth.currentUser || !uid) return;
                try {
                    const docRef = doc(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'userRegistry', uid);
                    await deleteDoc(docRef);
                } catch (e) {
                    console.warn('회원 정보 클라우드 삭제 오류:', e);
                }
            },

            async loadCurrentUserProgressFromCloud() {
                if (!this.isCloudConnected || !this.fbAuth.currentUser || !this.currentUser) return;
                try {
                    const profileKey = this.currentUser.uid;
                    const docRef = doc(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'userProgress', profileKey);
                    const snap = await getDoc(docRef);
                    if (snap.exists()) {
                        const data = snap.data();
                        if (data && data.progress) {
                            this.allUsersProgressMap[profileKey] = JSON.parse(data.progress);
                            this.saveProgressToLocal();
                            this.renderAll();
                        }
                    }
                } catch (e) {
                    console.warn('개인 기록 클라우드 로드 오류:', e);
                }
            },

            async syncUserProgressToCloud() {
                if (!this.isCloudConnected || !this.fbAuth.currentUser || !this.currentUser) return;
                try {
                    const profileKey = this.currentUser.uid;
                    const userMap = this.allUsersProgressMap[profileKey] || {};
                    const docRef = doc(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'userProgress', profileKey);
                    await setDoc(docRef, {
                        uid: profileKey,
                        name: this.currentUser.name,
                        updatedAt: Date.now(),
                        progress: JSON.stringify(userMap)
                    });
                } catch (e) {
                    console.warn('개인 기록 클라우드 저장 오류:', e);
                }
            },

            async syncSingleQuestionToCloud(qObj) {
                if (!this.isCloudConnected || !this.fbAuth.currentUser) return;
                try {
                    const qDocRef = doc(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'questions', qObj.id);
                    await setDoc(qDocRef, qObj);
                } catch (e) {
                    console.warn('문제 클라우드 저장 오류:', e);
                }
            },

            async deleteQuestionFromCloud(qId) {
                if (!this.isCloudConnected || !this.fbAuth.currentUser) return;
                try {
                    const qDocRef = doc(this.fbDb, 'artifacts', this.appId, 'public', 'data', 'questions', qId);
                    await deleteDoc(qDocRef);
                } catch (e) {
                    console.warn('문제 클라우드 삭제 오류:', e);
                }
            },

            // 현재 로그인한 사용자의 특정 문제 풀이 상태 조회
            getQuestionProgress(questionId) {
                if (!this.currentUser) {
                    return {
                        solved: false,
                        isCorrect: false,
                        userChoice: null,
                        understood: false,
                        bookmarked: false
                    };
                }
                const uid = this.currentUser.uid;
                const userMap = this.allUsersProgressMap[uid] || {};
                return userMap[questionId] || {
                    solved: false,
                    isCorrect: false,
                    userChoice: null,
                    understood: false,
                    bookmarked: false
                };
            },

            setQuestionProgress(questionId, newObj) {
                if (!this.currentUser) return;
                const uid = this.currentUser.uid;
                if (!this.allUsersProgressMap[uid]) {
                    this.allUsersProgressMap[uid] = {};
                }
                const current = this.allUsersProgressMap[uid][questionId] || { solved: false, isCorrect: false, userChoice: null, understood: false, bookmarked: false };
                this.allUsersProgressMap[uid][questionId] = { ...current, ...newObj };
                this.saveProgressToLocal();
                this.syncUserProgressToCloud();
            },

            ensureDefaultHierarchySelection() {
                const grades = this.getUniqueGrades();
                if (grades.length === 0) return;

                if (!this.selectedGrade || !grades.includes(this.selectedGrade)) {
                    this.selectedGrade = grades[0];
                }

                const subjects = this.getUniqueSubjectsByGrade(this.selectedGrade);
                if (!this.selectedSubject || !subjects.includes(this.selectedSubject)) {
                    this.selectedSubject = subjects[0] || null;
                }

                const cohorts = this.getUniqueCohorts(this.selectedGrade, this.selectedSubject);
                if (this.selectedCohort !== 'ALL' && !cohorts.includes(this.selectedCohort)) {
                    this.selectedCohort = 'ALL';
                }
            },

            getUniqueGrades() {
                return [...new Set(this.questions.map(q => q.grade))].filter(Boolean);
            },

            getUniqueSubjectsByGrade(grade) {
                if (!grade) return [];
                return [...new Set(this.questions.filter(q => q.grade === grade).map(q => q.subject))].filter(Boolean);
            },

            getUniqueCohorts(grade, subject) {
                if (!grade || !subject) return [];
                return [...new Set(this.questions.filter(q => q.grade === grade && q.subject === subject).map(q => q.cohort))].filter(Boolean);
            },

            getHierarchyFilteredQuestions() {
                return this.questions.filter(q => {
                    if (this.selectedGrade && q.grade !== this.selectedGrade) return false;
                    if (this.selectedSubject && q.subject !== this.selectedSubject) return false;
                    if (this.selectedCohort && this.selectedCohort !== 'ALL' && q.cohort !== this.selectedCohort) return false;
                    return true;
                });
            },

            bindKeyboardEvents() {
                window.addEventListener('keydown', (e) => {
                    const quizSolveView = document.getElementById('quizSolveView');
                    if (quizSolveView && !quizSolveView.classList.contains('hidden')) {
                        if (e.key >= '1' && e.key <= '5') {
                            const num = Number(e.key);
                            const q = this.getCurrentQuizQuestion();
                            if (q && q.options && num <= q.options.filter(o => o && o.trim() !== '').length) {
                                this.selectQuizOption(num);
                            }
                        } else if (e.key === 'ArrowRight') {
                            this.goNextQuizQuestion();
                        } else if (e.key === 'ArrowLeft') {
                            this.goPrevQuizQuestion();
                        }
                    }
                });
            },

            // ================= 화면 전환 및 전체 렌더링 (엄격한 로그인 게이트 & admin 전용 분기) =================
            renderAll() {
                const gateEl = document.getElementById('authGateView');
                const headerEl = document.getElementById('appHeader');
                const mainEl = document.getElementById('appMain');
                const adminSwitchBar = document.getElementById('adminModeSwitchBar');

                // 비로그인 상태일 경우 모든 내부 콘텐츠를 숨기고 로그인 게이트만 표시
                if (!this.currentUser) {
                    this.unmountAdminUI();
                    gateEl.classList.remove('hidden');
                    headerEl.classList.add('hidden');
                    mainEl.classList.add('hidden');
                    this.renderAuthGate();
                    return;
                }

                // 로그인 완료 시 게이트를 숨기고 앱 헤더 및 메인 영역 활성화
                gateEl.classList.add('hidden');
                headerEl.classList.remove('hidden');
                mainEl.classList.remove('hidden');

                // 관리자 화면은 관리자 로그인 상태일 때만 DOM에 생성, 일반 사용자는 존재 자체가 없음
                const isAdminNow = !!(this.currentUser.isAdmin && this.isAdminUnlocked);
                if (isAdminNow) {
                    this.mountAdminUI();
                } else {
                    this.unmountAdminUI();
                }
                if (isAdminNow) {
                    adminSwitchBar.classList.remove('hidden');
                    adminSwitchBar.classList.add('flex');
                } else {
                    adminSwitchBar.classList.add('hidden');
                    adminSwitchBar.classList.remove('flex');
                }

                this.renderHeaderUserProfile();
                this.renderUserDashboard();
                if (isAdminNow) {
                    this.renderAdminPage();
                }
            },

            onGateIdInputChange(val) {
                const adminTyped = isAdminId(val);
                const passWrap = document.getElementById('gateAdminPasswordWrapper');
                const nameWrap = document.getElementById('gateUserNameWrapper');
                const submitBtnText = document.getElementById('gateSubmitBtnText');

                if (adminTyped) {
                    passWrap.classList.remove('hidden');
                    nameWrap.classList.add('hidden');
                    submitBtnText.textContent = '로그인';
                } else {
                    passWrap.classList.add('hidden');
                    nameWrap.classList.remove('hidden');
                    submitBtnText.textContent = '로그인 / 가입 승인 요청하기';
                }
            },

            renderAuthGate() {
                const recentSec = document.getElementById('recentUsersSection');
                const recentList = document.getElementById('recentUsersList');

                if (this.recentUsers && this.recentUsers.length > 0) {
                    recentSec.classList.remove('hidden');
                    recentList.innerHTML = this.recentUsers.map(u => {
                        const reg = this.userRegistryMap[u.uid];
                        let statusTag = '';
                        if (reg && reg.status === 'APPROVED') {
                            statusTag = `<span class="text-[10px] font-extrabold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">승인됨</span>`;
                        } else {
                            statusTag = `<span class="text-[10px] font-extrabold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded">승인대기</span>`;
                        }

                        return `
                            <button type="button" onclick="app.quickLogin('${this.escapeHtml(u.uid)}', '${this.escapeHtml(u.name)}')" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-brand-50 hover:text-brand-700 border border-slate-200 hover:border-brand-300 text-xs font-bold text-slate-700 transition-all">
                                <span>${this.escapeHtml(u.name)}</span>
                                <span class="text-[10px] text-slate-400 font-mono">(${this.escapeHtml(u.uid)})</span>
                                ${statusTag}
                            </button>
                        `;
                    }).join('');
                } else {
                    recentSec.classList.add('hidden');
                }
            },

            renderHeaderUserProfile() {
                if (!this.currentUser) return;
                const initial = (this.currentUser.name || 'U').trim().charAt(0).toUpperCase();
                document.getElementById('userAvatar').textContent = initial;
                document.getElementById('userNameDisplay').textContent = this.currentUser.name;
                document.getElementById('userSubDisplay').textContent = this.currentUser.isAdmin
                    ? '총괄 관리자'
                    : `학번/ID: ${this.currentUser.uid} (승인됨)`;
                document.getElementById('dashboardUserBadge').textContent = `${this.currentUser.name} (${this.currentUser.uid}) 님의 개인 학습 현황`;

                // 관리자 헤더 배지에 대기 중인 인원 표시
                const pendingCount = Object.values(this.userRegistryMap).filter(u => u.status === 'PENDING').length;
                const badge = document.getElementById('headerPendingCountBadge');
                if (badge) {
                    if (pendingCount > 0) {
                        badge.textContent = pendingCount;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }
            },

            switchMainTab(tab) {
                if (!this.currentUser) {
                    this.renderAll();
                    return;
                }
                const userTabBtn = document.getElementById('tabBtnUser');
                const adminTabBtn = document.getElementById('tabBtnAdmin');

                // 일반 사용자는 절대 ADMIN 뷰로 전환 불가
                if (tab === 'ADMIN') {
                    if (!this.requireAdmin()) {
                        tab = 'USER';
                    }
                }
                if (tab === 'ADMIN') {
                    this.setViewVisible('userDashboardView', false);
                    this.setViewVisible('quizSolveView', false);
                    this.setViewVisible('adminPageView', true);

                    if (adminTabBtn && userTabBtn) {
                        adminTabBtn.className = 'inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all bg-white text-brand-700 shadow-xs';
                        userTabBtn.className = 'inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition-all';
                    }
                    this.renderAdminPage();
                } else {
                    this.setViewVisible('adminPageView', false);
                    this.setViewVisible('quizSolveView', false);
                    this.setViewVisible('userDashboardView', true);

                    if (adminTabBtn && userTabBtn) {
                        userTabBtn.className = 'inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all bg-white text-brand-700 shadow-xs';
                        adminTabBtn.className = 'inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition-all';
                    }
                    this.renderUserDashboard();
                }
            },

            // ================= [사용자 대시보드] 렌더링 =================
            renderUserDashboard() {
                this.ensureDefaultHierarchySelection();

                // 1. 전체 통계 계산
                const totalQ = this.questions.length;
                let solvedCount = 0;
                let correctCount = 0;
                let reviewCount = 0;
                let understoodCount = 0;

                this.questions.forEach(q => {
                    const p = this.getQuestionProgress(q.id);
                    if (p.solved) {
                        solvedCount++;
                        if (p.isCorrect) correctCount++;
                    }
                    if ((p.solved && !p.isCorrect) || p.bookmarked) reviewCount++;
                    if (p.understood) understoodCount++;
                });

                const totalPercent = totalQ > 0 ? Math.round((solvedCount / totalQ) * 100) : 0;
                const accuracyPercent = solvedCount > 0 ? Math.round((correctCount / solvedCount) * 100) : 0;

                document.getElementById('totalProgressPercent').textContent = `${totalPercent}%`;
                document.getElementById('totalProgressFraction').textContent = `(${solvedCount} / ${totalQ} 문제)`;
                document.getElementById('totalUnderstoodCount').textContent = `${understoodCount}문제 완벽 이해`;
                document.getElementById('totalProgressBar').style.width = `${totalPercent}%`;

                document.getElementById('statAllCount').textContent = totalQ;
                document.getElementById('statMySolved').textContent = solvedCount;
                document.getElementById('statMyAccuracy').textContent = `${accuracyPercent}%`;
                document.getElementById('statMyReview').textContent = reviewCount;

                // 2. Step 1 (학년) 카드 렌더링
                this.renderStep1Grades();

                // 3. Step 2 (과목) 카드 렌더링
                this.renderStep2Subjects();

                // 4. Step 3 (기출 학번) 카드 렌더링
                this.renderStep3Cohorts();

                // 5. 선택된 범위 요약 및 문제 미리보기 리스트 렌더링
                this.renderSelectedTargetSummary();
            },

            renderStep1Grades() {
                const container = document.getElementById('step1GradeContainer');
                const grades = this.getUniqueGrades();

                if (grades.length === 0) {
                    container.innerHTML = `<div class="col-span-full text-xs text-slate-400 py-3">아직 등록된 기출문제가 없습니다.</div>`;
                    return;
                }

                container.innerHTML = grades.map(grade => {
                    const qInGrade = this.questions.filter(q => q.grade === grade);
                    const solvedInGrade = qInGrade.filter(q => this.getQuestionProgress(q.id).solved).length;
                    const pct = qInGrade.length > 0 ? Math.round((solvedInGrade / qInGrade.length) * 100) : 0;
                    const isSelected = (this.selectedGrade === grade);

                    return `
                        <button onclick="app.selectGrade('${this.escapeHtml(grade)}')" class="p-3.5 rounded-xl border text-left transition-all flex flex-col justify-between ${
                            isSelected
                                ? 'border-2 border-brand-600 bg-brand-50/70 shadow-xs'
                                : 'border-slate-200 bg-white hover:border-brand-300 hover:bg-slate-50'
                        }">
                            <div class="flex items-center justify-between w-full mb-2">
                                <span class="font-extrabold text-sm ${isSelected ? 'text-brand-700' : 'text-slate-800'}">${this.escapeHtml(grade)}</span>
                                ${isSelected ? '<i class="ph-fill ph-check-circle text-brand-600 text-base"></i>' : ''}
                            </div>
                            <div class="w-full space-y-1">
                                <div class="flex justify-between text-[11px] font-semibold text-slate-500">
                                    <span>${qInGrade.length}문항</span>
                                    <span class="${isSelected ? 'text-brand-700 font-bold' : ''}">${pct}% 완료</span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-brand-600 rounded-full" style="width: ${pct}%"></div>
                                </div>
                            </div>
                        </button>
                    `;
                }).join('');
            },

            renderStep2Subjects() {
                const container = document.getElementById('step2SubjectContainer');
                const subjects = this.getUniqueSubjectsByGrade(this.selectedGrade);
                document.getElementById('step2HelperText').textContent = `${this.selectedGrade || ''} 개설 과목 (${subjects.length}개)`;

                if (subjects.length === 0) {
                    container.innerHTML = `<div class="col-span-full text-xs text-slate-400 py-3">해당 학년에 등록된 과목이 없습니다.</div>`;
                    return;
                }

                container.innerHTML = subjects.map(subject => {
                    const qInSub = this.questions.filter(q => q.grade === this.selectedGrade && q.subject === subject);
                    const solvedList = qInSub.filter(q => this.getQuestionProgress(q.id).solved);
                    const correctList = solvedList.filter(q => this.getQuestionProgress(q.id).isCorrect);
                    const pct = qInSub.length > 0 ? Math.round((solvedList.length / qInSub.length) * 100) : 0;
                    const acc = solvedList.length > 0 ? Math.round((correctList.length / solvedList.length) * 100) : 0;
                    const isSelected = (this.selectedSubject === subject);

                    return `
                        <button onclick="app.selectSubject('${this.escapeHtml(subject)}')" class="p-4 rounded-xl border text-left transition-all flex flex-col justify-between ${
                            isSelected
                                ? 'border-2 border-brand-600 bg-brand-50/70 shadow-xs'
                                : 'border-slate-200 bg-white hover:border-brand-300 hover:bg-slate-50'
                        }">
                            <div class="flex items-start justify-between w-full mb-3">
                                <div>
                                    <span class="text-[11px] font-bold text-indigo-600 block">${this.escapeHtml(this.selectedGrade)}</span>
                                    <h4 class="font-extrabold text-base ${isSelected ? 'text-brand-800' : 'text-slate-900'} mt-0.5">${this.escapeHtml(subject)}</h4>
                                </div>
                                <span class="text-xs font-extrabold px-2 py-0.5 rounded-md ${isSelected ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-600'}">${qInSub.length}문제</span>
                            </div>
                            <div class="space-y-1.5 w-full">
                                <div class="flex justify-between text-[11px] font-semibold text-slate-500">
                                    <span>진도율 ${pct}% (${solvedList.length}/${qInSub.length})</span>
                                    <span class="text-emerald-600 font-bold">정답률 ${acc}%</span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-indigo-600 rounded-full" style="width: ${pct}%"></div>
                                </div>
                            </div>
                        </button>
                    `;
                }).join('');
            },

            renderStep3Cohorts() {
                const container = document.getElementById('step3CohortContainer');
                const cohorts = this.getUniqueCohorts(this.selectedGrade, this.selectedSubject);
                const allSubQuestions = this.questions.filter(q => q.grade === this.selectedGrade && q.subject === this.selectedSubject);
                const allSubSolved = allSubQuestions.filter(q => this.getQuestionProgress(q.id).solved).length;

                let html = `
                    <button onclick="app.selectCohort('ALL')" class="p-3.5 rounded-xl border text-left transition-all flex flex-col justify-between ${
                        this.selectedCohort === 'ALL'
                            ? 'border-2 border-brand-600 bg-brand-50/70 shadow-xs'
                            : 'border-slate-200 bg-white hover:border-brand-300'
                    }">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="font-extrabold text-xs sm:text-sm ${this.selectedCohort === 'ALL' ? 'text-brand-700' : 'text-slate-800'}">전체 기출 학번 통합</span>
                            ${this.selectedCohort === 'ALL' ? '<i class="ph-fill ph-check-circle text-brand-600"></i>' : ''}
                        </div>
                        <p class="text-[11px] font-semibold text-slate-500">총 ${allSubQuestions.length}문항 (${allSubSolved}완료)</p>
                    </button>
                `;

                cohorts.forEach(cohort => {
                    const qInCohort = allSubQuestions.filter(q => q.cohort === cohort);
                    const solvedInCohort = qInCohort.filter(q => this.getQuestionProgress(q.id).solved).length;
                    const isSelected = (this.selectedCohort === cohort);

                    html += `
                        <button onclick="app.selectCohort('${this.escapeHtml(cohort)}')" class="p-3.5 rounded-xl border text-left transition-all flex flex-col justify-between ${
                            isSelected
                                ? 'border-2 border-brand-600 bg-brand-50/70 shadow-xs'
                                : 'border-slate-200 bg-white hover:border-brand-300'
                        }">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-extrabold text-xs sm:text-sm ${isSelected ? 'text-brand-700' : 'text-slate-800'}">🎓 ${this.escapeHtml(cohort)}</span>
                                ${isSelected ? '<i class="ph-fill ph-check-circle text-brand-600"></i>' : ''}
                            </div>
                            <p class="text-[11px] font-semibold text-slate-500">${qInCohort.length}문항 (${solvedInCohort}/${qInCohort.length} 완료)</p>
                        </button>
                    `;
                });

                container.innerHTML = html;
            },

            renderSelectedTargetSummary() {
                const cohortLabel = this.selectedCohort === 'ALL' ? '전체 기출 학번' : this.selectedCohort;
                const pathStr = `${this.selectedGrade || '-'} > ${this.selectedSubject || '-'} > ${cohortLabel}`;

                document.getElementById('selectionBreadcrumb').innerHTML = `
                    <span>${this.escapeHtml(this.selectedGrade || '-')}</span>
                    <i class="ph-bold ph-caret-right text-slate-400"></i>
                    <span>${this.escapeHtml(this.selectedSubject || '-')}</span>
                    <i class="ph-bold ph-caret-right text-slate-400"></i>
                    <span class="text-amber-300">${this.escapeHtml(cohortLabel)}</span>
                `;

                document.getElementById('selectedTargetTitle').textContent = `🎯 선택된 기출 세트: [${pathStr}]`;

                const targetList = this.getHierarchyFilteredQuestions();
                const unsolvedCount = targetList.filter(q => !this.getQuestionProgress(q.id).solved).length;
                const wrongOrBookmarkedCount = targetList.filter(q => {
                    const p = this.getQuestionProgress(q.id);
                    return (p.solved && !p.isCorrect) || p.bookmarked;
                }).length;
                const notUnderstoodCount = targetList.filter(q => !this.getQuestionProgress(q.id).understood).length;

                document.getElementById('modeCountAll').textContent = `${targetList.length}문제`;
                document.getElementById('modeCountUnsolved').textContent = `${unsolvedCount}문제`;
                document.getElementById('modeCountWrong').textContent = `${wrongOrBookmarkedCount}문제`;
                document.getElementById('modeCountNotUnderstood').textContent = `${notUnderstoodCount}문제`;
                document.getElementById('previewListCountBadge').textContent = `총 ${targetList.length}문항`;

                // 하단 미리보기 리스트
                const listEl = document.getElementById('userQuestionPreviewList');
                if (targetList.length === 0) {
                    listEl.innerHTML = `<div class="p-8 text-center text-xs text-slate-400">선택한 조건에 등록된 기출문제가 없습니다.</div>`;
                    return;
                }

                listEl.innerHTML = targetList.map((q, idx) => {
                    const p = this.getQuestionProgress(q.id);
                    let statusBadge = `<span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-500">미풀이</span>`;
                    if (p.solved) {
                        statusBadge = p.isCorrect
                            ? `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">정답</span>`
                            : `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">오답</span>`;
                    }
                    const understoodBadge = p.understood
                        ? `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-500/10 text-emerald-700">✅ 해설숙지</span>`
                        : '';
                    const pinBadge = p.bookmarked
                        ? `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">📌 오답노트</span>`
                        : '';

                    return `
                        <div onclick="app.startQuizFromSpecificQuestion('${q.id}')" class="p-4 sm:px-6 hover:bg-slate-50 cursor-pointer transition-colors flex items-center justify-between gap-3 group">
                            <div class="min-w-0 flex-1 space-y-1">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="text-xs font-extrabold text-brand-600">Q${idx + 1}.</span>
                                    <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-amber-50 text-amber-800">${this.escapeHtml(q.cohort)}</span>
                                    ${statusBadge}
                                    ${understoodBadge}
                                    ${pinBadge}
                                </div>
                                <p class="text-xs sm:text-sm font-semibold text-slate-800 truncate group-hover:text-brand-600">${this.escapeHtml(q.question)}</p>
                            </div>
                            <i class="ph-bold ph-caret-right text-slate-400 group-hover:text-brand-600"></i>
                        </div>
                    `;
                }).join('');
            },

            selectGrade(grade) {
                this.selectedGrade = grade;
                const subjects = this.getUniqueSubjectsByGrade(grade);
                this.selectedSubject = subjects[0] || null;
                this.selectedCohort = 'ALL';
                this.renderUserDashboard();
            },

            selectSubject(subject) {
                this.selectedSubject = subject;
                this.selectedCohort = 'ALL';
                this.renderUserDashboard();
            },

            selectCohort(cohort) {
                this.selectedCohort = cohort;
                this.renderUserDashboard();
            },

            // ================= [퀴즈 풀이] 로직 =================
            startFilteredQuiz(mode) {
                const baseList = this.getHierarchyFilteredQuestions();
                let filtered = [];
                let modeLabel = '전체 문제 풀이';

                if (mode === 'ALL') {
                    filtered = [...baseList];
                    modeLabel = '전체 문제 풀이';
                } else if (mode === 'UNSOLVED') {
                    filtered = baseList.filter(q => !this.getQuestionProgress(q.id).solved);
                    modeLabel = '안 푼 문제 집중 풀이';
                } else if (mode === 'WRONG_OR_BOOKMARK') {
                    filtered = baseList.filter(q => {
                        const p = this.getQuestionProgress(q.id);
                        return (p.solved && !p.isCorrect) || p.bookmarked;
                    });
                    modeLabel = '오답 & 별표 노트 복습';
                } else if (mode === 'NOT_UNDERSTOOD') {
                    filtered = baseList.filter(q => !this.getQuestionProgress(q.id).understood);
                    modeLabel = '해설 미숙지 문제 복습';
                }

                if (filtered.length === 0) {
                    this.showToast('선택하신 조건에 해당하는 기출문제가 없습니다!', 'info');
                    return;
                }

                this.quizQueue = filtered.map(q => q.id);
                this.currentQuizIdx = 0;
                this.currentQuizModeName = modeLabel;

                this.openQuizView();
            },

            startQuizFromSpecificQuestion(qId) {
                const baseList = this.getHierarchyFilteredQuestions();
                const idx = baseList.findIndex(q => q.id === qId);
                if (idx === -1) return;

                this.quizQueue = baseList.map(q => q.id);
                this.currentQuizIdx = idx;
                this.currentQuizModeName = '선택 문항 이어풀기';

                this.openQuizView();
            },

            openQuizView() {
                this.setViewVisible('userDashboardView', false);
                this.setViewVisible('adminPageView', false);
                this.setViewVisible('quizSolveView', true);
                this.renderCurrentQuizQuestion();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            },

            exitQuizToDashboard() {
                document.getElementById('quizSolveView').classList.add('hidden');
                document.getElementById('userDashboardView').classList.remove('hidden');
                this.renderUserDashboard();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            },

            getCurrentQuizQuestion() {
                const qId = this.quizQueue[this.currentQuizIdx];
                return this.questions.find(q => q.id === qId);
            },

            renderCurrentQuizQuestion() {
                const q = this.getCurrentQuizQuestion();
                if (!q) {
                    this.exitQuizToDashboard();
                    return;
                }

                const p = this.getQuestionProgress(q.id);
                const total = this.quizQueue.length;
                const currentNum = this.currentQuizIdx + 1;

                document.getElementById('quizPathBadge').textContent = `${q.grade} > ${q.subject} > ${q.cohort}`;
                document.getElementById('quizModeLabel').textContent = this.currentQuizModeName;
                document.getElementById('quizCounterBadge').textContent = `${currentNum} / ${total}`;

                document.getElementById('qMetaGrade').textContent = q.grade;
                document.getElementById('qMetaSubject').textContent = q.subject;
                document.getElementById('qMetaCohort').textContent = `🎓 ${q.cohort}`;

                const prevBadge = document.getElementById('qPrevStatusBadge');
                if (!p.solved) {
                    prevBadge.textContent = '미풀이 문항';
                    prevBadge.className = 'text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-100 text-slate-500';
                } else if (p.isCorrect) {
                    prevBadge.textContent = '내 기록: 정답';
                    prevBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700';
                } else {
                    prevBadge.textContent = '내 기록: 오답';
                    prevBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-rose-50 text-rose-700';
                }

                this.updateQuizBookmarkButtonUI(p.bookmarked);
                this.renderQuizPalette();

                document.getElementById('qIndexLabel').textContent = `Q${currentNum}.`;
                document.getElementById('qTextDisplay').textContent = q.question;

                // 객관식 보기 생성
                const validOptions = q.options.filter(o => o && o.trim() !== '');
                const optContainer = document.getElementById('qOptionsContainer');
                optContainer.innerHTML = validOptions.map((optText, i) => {
                    const num = i + 1;
                    return `
                        <button id="quizOptBtn_${num}" onclick="app.selectQuizOption(${num})" class="w-full text-left p-4 rounded-xl border border-slate-200 hover:border-brand-400 hover:bg-brand-50/40 transition-all flex items-start gap-3.5 group">
                            <span id="quizOptCircle_${num}" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
                                ${num}
                            </span>
                            <span class="text-sm sm:text-base font-medium text-slate-800 leading-snug flex-1">${this.escapeHtml(optText)}</span>
                        </button>
                    `;
                }).join('');

                // 해설 영역 초기화
                document.getElementById('qExplanationSection').classList.add('hidden');
                document.getElementById('btnRevealAnswer').classList.remove('hidden');
                document.getElementById('chkQuizUnderstood').checked = !!p.understood;

                document.getElementById('btnQuizPrev').disabled = (this.currentQuizIdx === 0);
                document.getElementById('txtQuizNext').textContent = (this.currentQuizIdx === total - 1) ? '풀이 완료 (대시보드로)' : '다음 문제';
            },

            renderQuizPalette() {
                const container = document.getElementById('quizPaletteContainer');
                container.innerHTML = this.quizQueue.map((qId, idx) => {
                    const p = this.getQuestionProgress(qId);
                    const isCurrent = (idx === this.currentQuizIdx);
                    let colorCls = 'bg-slate-100 text-slate-600 border-slate-200';
                    if (p.solved) {
                        colorCls = p.isCorrect
                            ? 'bg-emerald-50 text-emerald-700 border-emerald-300'
                            : 'bg-rose-50 text-rose-700 border-rose-300';
                    }
                    const ringCls = isCurrent ? 'ring-2 ring-brand-600 font-extrabold scale-105' : 'font-semibold opacity-85 hover:opacity-100';

                    return `
                        <button onclick="app.jumpToQuizIndex(${idx})" class="w-8 h-8 rounded-lg border text-xs flex items-center justify-center transition-all ${colorCls} ${ringCls}">
                            ${idx + 1}
                        </button>
                    `;
                }).join('');
            },

            jumpToQuizIndex(idx) {
                this.currentQuizIdx = idx;
                this.renderCurrentQuizQuestion();
            },

            selectQuizOption(choiceNum) {
                const q = this.getCurrentQuizQuestion();
                if (!q) return;

                const correctNum = Number(q.answer);
                const isCorrect = (choiceNum === correctNum);
                const currentP = this.getQuestionProgress(q.id);

                this.setQuestionProgress(q.id, {
                    solved: true,
                    isCorrect,
                    userChoice: choiceNum,
                    bookmarked: !isCorrect ? true : currentP.bookmarked
                });

                const updatedP = this.getQuestionProgress(q.id);
                this.updateQuizBookmarkButtonUI(updatedP.bookmarked);
                this.renderQuizPalette();
                this.displayAnswerFeedbackAndExplanation(choiceNum, correctNum);
            },

            revealQuizAnswerDirectly() {
                const q = this.getCurrentQuizQuestion();
                if (!q) return;
                this.displayAnswerFeedbackAndExplanation(null, Number(q.answer));
            },

            displayAnswerFeedbackAndExplanation(selectedNum, correctNum) {
                const q = this.getCurrentQuizQuestion();
                const validCount = q.options.filter(o => o && o.trim() !== '').length;

                for (let i = 1; i <= validCount; i++) {
                    const btn = document.getElementById(`quizOptBtn_${i}`);
                    const circle = document.getElementById(`quizOptCircle_${i}`);
                    if (!btn || !circle) continue;

                    btn.disabled = true;
                    btn.className = 'w-full text-left p-4 rounded-xl border transition-all flex items-start gap-3.5 opacity-80';

                    if (i === correctNum) {
                        btn.className = 'w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-900 shadow-xs flex items-start gap-3.5';
                        circle.className = 'w-7 h-7 rounded-lg bg-emerald-600 text-white font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5';
                    } else if (i === selectedNum && selectedNum !== correctNum) {
                        btn.className = 'w-full text-left p-4 rounded-xl border-2 border-rose-500 bg-rose-50 text-rose-900 shadow-xs flex items-start gap-3.5';
                        circle.className = 'w-7 h-7 rounded-lg bg-rose-600 text-white font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5';
                    }
                }

                document.getElementById('btnRevealAnswer').classList.add('hidden');
                const expSec = document.getElementById('qExplanationSection');
                expSec.classList.remove('hidden');

                const isCorrect = (selectedNum === correctNum);
                const resultBadge = document.getElementById('qResultStatusBadge');
                if (selectedNum === null) {
                    resultBadge.textContent = '💡 해설 바로 보기';
                    resultBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-slate-100 text-slate-700';
                } else if (isCorrect) {
                    resultBadge.textContent = '🎉 정답입니다!';
                    resultBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-800';
                } else {
                    resultBadge.textContent = `❌ 오답입니다 (선택: ${selectedNum}번, 정답: ${correctNum}번)`;
                    resultBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-rose-100 text-rose-800';
                }

                document.getElementById('qExplanationText').textContent = q.explanation;
                this.renderQuizPalette();
            },

            toggleQuizBookmark() {
                const q = this.getCurrentQuizQuestion();
                if (!q) return;
                const p = this.getQuestionProgress(q.id);
                const nextState = !p.bookmarked;
                this.setQuestionProgress(q.id, { bookmarked: nextState });
                this.updateQuizBookmarkButtonUI(nextState);
                this.showToast(nextState ? '📌 오답노트에 고정되었습니다.' : '오답노트 고정이 해제되었습니다.', 'info');
            },

            updateQuizBookmarkButtonUI(isBookmarked) {
                const btn = document.getElementById('btnQuizBookmark');
                if (!btn) return;
                if (isBookmarked) {
                    btn.className = 'inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-extrabold bg-amber-500 text-white shadow-xs transition-colors';
                    btn.innerHTML = '<i class="ph-fill ph-bookmark-simple text-base"></i><span>오답노트 고정됨</span>';
                } else {
                    btn.className = 'inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-extrabold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors';
                    btn.innerHTML = '<i class="ph-bold ph-bookmark-simple text-base"></i><span>오답노트 고정</span>';
                }
            },

            onQuizUnderstoodChange(chk) {
                const q = this.getCurrentQuizQuestion();
                if (!q) return;
                this.setQuestionProgress(q.id, { understood: chk.checked });
                this.renderQuizPalette();
                if (chk.checked) {
                    this.showToast('✅ 해설 숙지 완료 체크되었습니다!', 'success');
                }
            },

            goPrevQuizQuestion() {
                if (this.currentQuizIdx > 0) {
                    this.currentQuizIdx--;
                    this.renderCurrentQuizQuestion();
                }
            },

            goNextQuizQuestion() {
                if (this.currentQuizIdx < this.quizQueue.length - 1) {
                    this.currentQuizIdx++;
                    this.renderCurrentQuizQuestion();
                } else {
                    this.showToast('모든 문제 풀이를 완료했습니다! 대시보드로 이동합니다.', 'success');
                    this.exitQuizToDashboard();
                }
            },

            // ================= [관리자 페이지] 회원 승인 & 문제 관리 기능 =================
            openAdminPasswordChangeModal() {
                if (!this.requireAdmin()) return;
                this.openConfirmDialog(
                    '관리자 비밀번호 변경',
                    '새 비밀번호(8자 이상)를 입력하세요. 이 브라우저에 즉시 적용되고, 새 해시값이 클립보드에 복사됩니다. 모든 기기에 적용하려면 코드 상단의 ADMIN_PASSWORD_HASH 값을 복사된 해시로 바꿔 다시 배포하세요.',
                    (newPass) => {
                        const pw = (newPass || '').trim();
                        if (pw.length < 8) {
                            this.showToast('비밀번호는 최소 8자 이상이어야 합니다.', 'error');
                            return;
                        }
                        const newHash = sha256Hex(pw);
                        localStorage.setItem(STORAGE_KEYS.ADMIN_HASH, newHash);
                        localStorage.removeItem(STORAGE_KEYS.ADMIN_PIN);
                        // 현재 세션은 새 비밀번호 기준으로 갱신
                        sessionStorage.setItem(STORAGE_KEYS.ADMIN_SESSION, this.makeAdminSessionToken());
                        this.copyTextToClipboard(newHash);
                        this.showToast('비밀번호가 변경되었습니다. 새 해시가 클립보드에 복사되었습니다.', 'success');
                    },
                    true
                );
            },

            copyTextToClipboard(text) {
                const ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch (e) { console.log('ADMIN_PASSWORD_HASH =', text); }
                ta.remove();
            },

            renderAdminPage() {
                if (!this.currentUser || !this.currentUser.isAdmin || !this.isAdminUiMounted) return;

                // 1. 회원 승인 요청 테이블 렌더링
                this.renderAdminUserApprovalList();

                // 2. 필터 드롭다운 갱신
                const gSelect = document.getElementById('adminFilterGrade');
                const sSelect = document.getElementById('adminFilterSubject');
                const cSelect = document.getElementById('adminFilterCohort');

                const prevG = gSelect.value || 'ALL';
                const prevS = sSelect.value || 'ALL';
                const prevC = cSelect.value || 'ALL';

                const grades = [...new Set(this.questions.map(q => q.grade))];
                const subjects = [...new Set(this.questions.map(q => q.subject))];
                const cohorts = [...new Set(this.questions.map(q => q.cohort))];

                gSelect.innerHTML = `<option value="ALL">전체 학년 (${grades.length})</option>` +
                    grades.map(g => `<option value="${this.escapeHtml(g)}" ${prevG === g ? 'selected' : ''}>${this.escapeHtml(g)}</option>`).join('');

                sSelect.innerHTML = `<option value="ALL">전체 과목 (${subjects.length})</option>` +
                    subjects.map(s => `<option value="${this.escapeHtml(s)}" ${prevS === s ? 'selected' : ''}>${this.escapeHtml(s)}</option>`).join('');

                cSelect.innerHTML = `<option value="ALL">전체 기출 학번 (${cohorts.length})</option>` +
                    cohorts.map(c => `<option value="${this.escapeHtml(c)}" ${prevC === c ? 'selected' : ''}>${this.escapeHtml(c)}</option>`).join('');

                this.renderAdminTableRows();
            },

            renderAdminUserApprovalList() {
                const tbody = document.getElementById('adminUserApprovalTableBody');
                const pendingBadge = document.getElementById('adminPendingBadge');
                if (!tbody) return;

                const users = Object.values(this.userRegistryMap).sort((a, b) => {
                    // PENDING 우선 정렬 후 최신 요청순
                    if (a.status === 'PENDING' && b.status !== 'PENDING') return -1;
                    if (a.status !== 'PENDING' && b.status === 'PENDING') return 1;
                    return (b.requestedAt || 0) - (a.requestedAt || 0);
                });

                const pendingCount = users.filter(u => u.status === 'PENDING').length;
                pendingBadge.textContent = `승인 대기 ${pendingCount}명`;
                pendingBadge.className = pendingCount > 0
                    ? 'px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-rose-100 text-rose-700 animate-pulse'
                    : 'px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-slate-100 text-slate-600';

                this.renderHeaderUserProfile();

                if (users.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400 text-xs">아직 로그인 승인을 요청한 일반 사용자가 없습니다.</td></tr>`;
                    return;
                }

                tbody.innerHTML = users.map(u => {
                    const userProgress = this.allUsersProgressMap[u.uid] || {};
                    const solvedCount = Object.values(userProgress).filter(p => p && p.solved).length;
                    const dateStr = u.requestedAt ? new Date(u.requestedAt).toLocaleString('ko-KR', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';

                    let statusBadge = '';
                    if (u.status === 'APPROVED') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>승인 완료</span>`;
                    } else if (u.status === 'REJECTED') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-rose-50 text-rose-700 border border-rose-200">승인 보류/차단</span>`;
                    } else {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-amber-50 text-amber-800 border border-amber-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span>승인 대기중</span>`;
                    }

                    return `
                        <tr class="hover:bg-slate-50/90">
                            <td class="py-3 px-4 whitespace-nowrap">${statusBadge}</td>
                            <td class="py-3 px-4 font-extrabold text-slate-900">${this.escapeHtml(u.name)}</td>
                            <td class="py-3 px-4 font-mono text-xs text-slate-600">${this.escapeHtml(u.uid)}</td>
                            <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">${dateStr}</td>
                            <td class="py-3 px-4 text-xs font-bold text-indigo-700">${solvedCount} / ${this.questions.length} 문제 풀이</td>
                            <td class="py-3 px-4 text-right whitespace-nowrap space-x-1">
                                ${u.status !== 'APPROVED' ? `
                                    <button onclick="app.setUserApprovalStatus('${this.escapeHtml(u.uid)}', 'APPROVED')" class="px-3 py-1.5 rounded-lg text-xs font-extrabold bg-emerald-600 hover:bg-emerald-700 text-white shadow-2xs transition-colors">
                                        승인하기
                                    </button>
                                ` : `
                                    <button onclick="app.setUserApprovalStatus('${this.escapeHtml(u.uid)}', 'PENDING')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 transition-colors">
                                        승인 취소(대기)
                                    </button>
                                `}
                                <button onclick="app.deleteUserFromRegistry('${this.escapeHtml(u.uid)}')" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50" title="회원 목록에서 삭제">
                                    <i class="ph-bold ph-trash text-sm"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            },

            setUserApprovalStatus(uid, nextStatus) {
                if (!this.requireAdmin()) return;
                if (!this.userRegistryMap[uid]) return;
                this.userRegistryMap[uid].status = nextStatus;
                this.userRegistryMap[uid].updatedAt = Date.now();
                this.saveUserRegistryToLocal();
                this.syncUserAccountToCloud(this.userRegistryMap[uid]);
                this.renderAdminUserApprovalList();

                const uName = this.userRegistryMap[uid].name;
                if (nextStatus === 'APPROVED') {
                    this.showToast(`✅ [${uName} (${uid})] 회원의 로그인을 승인했습니다!`, 'success');
                } else {
                    this.showToast(`[${uName} (${uid})] 회원을 승인 대기 상태로 변경했습니다.`, 'info');
                }
            },

            approveAllPendingUsers() {
                if (!this.requireAdmin()) return;
                const pendingList = Object.values(this.userRegistryMap).filter(u => u.status === 'PENDING');
                if (pendingList.length === 0) {
                    this.showToast('현재 승인 대기 중인 회원이 없습니다.', 'info');
                    return;
                }
                pendingList.forEach(u => {
                    u.status = 'APPROVED';
                    u.updatedAt = Date.now();
                    this.syncUserAccountToCloud(u);
                });
                this.saveUserRegistryToLocal();
                this.renderAdminUserApprovalList();
                this.showToast(`총 ${pendingList.length}명의 대기 회원을 모두 승인했습니다!`, 'success');
            },

            adminRegisterApprovedUser(e) {
                e.preventDefault();
                if (!this.requireAdmin()) return;
                const uidInput = document.getElementById('adminPreApproveUid');
                const nameInput = document.getElementById('adminPreApproveName');
                const uid = uidInput.value.trim().replace(/[^a-zA-Z0-9_@.-]/g, '_');
                const name = nameInput.value.trim();

                if (!uid || !name) return;
                if (isAdminId(uid)) {
                    this.showToast('사용할 수 없는 아이디입니다.', 'error');
                    return;
                }

                const accountObj = {
                    uid,
                    name,
                    status: 'APPROVED',
                    requestedAt: Date.now(),
                    updatedAt: Date.now()
                };
                this.userRegistryMap[uid] = accountObj;
                this.saveUserRegistryToLocal();
                this.syncUserAccountToCloud(accountObj);

                uidInput.value = '';
                nameInput.value = '';
                this.renderAdminUserApprovalList();
                this.showToast(`✅ [${name} (${uid})] 계정이 즉시 승인 상태로 등록되었습니다.`, 'success');
            },

            deleteUserFromRegistry(uid) {
                if (!this.requireAdmin()) return;
                const target = this.userRegistryMap[uid];
                if (!target) return;
                this.openConfirmDialog(
                    '회원 계정 삭제',
                    `[${target.name} (${uid})] 회원을 승인 목록에서 삭제하시겠습니까? 삭제 시 해당 사용자는 다시 승인 요청을 해야 합니다.`,
                    () => {
                        delete this.userRegistryMap[uid];
                        this.saveUserRegistryToLocal();
                        this.deleteUserAccountFromCloud(uid);
                        this.renderAdminUserApprovalList();
                        this.showToast('회원 계정이 목록에서 삭제되었습니다.', 'info');
                    }
                );
            },

            onAdminFilterChange() {
                this.renderAdminTableRows();
            },

            renderAdminTableRows() {
                const gVal = document.getElementById('adminFilterGrade').value;
                const sVal = document.getElementById('adminFilterSubject').value;
                const cVal = document.getElementById('adminFilterCohort').value;
                const keyword = (document.getElementById('adminSearchInput').value || '').trim().toLowerCase();

                const filtered = this.questions.filter(q => {
                    if (gVal !== 'ALL' && q.grade !== gVal) return false;
                    if (sVal !== 'ALL' && q.subject !== sVal) return false;
                    if (cVal !== 'ALL' && q.cohort !== cVal) return false;
                    if (keyword) {
                        const hay = `${q.question} ${q.explanation} ${q.grade} ${q.subject} ${q.cohort}`.toLowerCase();
                        if (!hay.includes(keyword)) return false;
                    }
                    return true;
                });

                document.getElementById('adminTableCount').textContent = `${filtered.length}건`;
                const tbody = document.getElementById('adminQuestionTableBody');

                if (filtered.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="py-10 text-center text-slate-400">조건에 맞는 기출문제가 없습니다.</td></tr>`;
                    return;
                }

                tbody.innerHTML = filtered.map((q, i) => `
                    <tr class="hover:bg-slate-50/80">
                        <td class="py-3.5 px-4 font-bold text-slate-400">${i + 1}</td>
                        <td class="py-3.5 px-3"><span class="px-2 py-1 rounded-md bg-slate-100 text-slate-700 font-bold text-xs">${this.escapeHtml(q.grade)}</span></td>
                        <td class="py-3.5 px-3"><span class="px-2 py-1 rounded-md bg-indigo-50 text-indigo-700 font-bold text-xs">${this.escapeHtml(q.subject)}</span></td>
                        <td class="py-3.5 px-3"><span class="px-2 py-1 rounded-md bg-amber-50 text-amber-800 font-bold text-xs">${this.escapeHtml(q.cohort)}</span></td>
                        <td class="py-3.5 px-4 max-w-md">
                            <p class="font-bold text-slate-800 truncate">${this.escapeHtml(q.question)}</p>
                            <p class="text-[11px] text-emerald-700 font-semibold mt-0.5">정답: ${q.answer}번 (${this.escapeHtml(q.options[q.answer - 1] || '')})</p>
                        </td>
                        <td class="py-3.5 px-4 text-right whitespace-nowrap">
                            <button onclick="app.openAdminQuestionModal('${q.id}')" class="p-1.5 rounded-lg text-slate-500 hover:text-brand-600 hover:bg-brand-50" title="수정">
                                <i class="ph-bold ph-pencil-simple text-base"></i>
                            </button>
                            <button onclick="app.confirmDeleteAdminQuestion('${q.id}')" class="p-1.5 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50" title="삭제">
                                <i class="ph-bold ph-trash text-base"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            },

            openAdminQuestionModal(editId = null) {
                if (!this.requireAdmin()) return;
                const form = document.getElementById('adminQuestionForm');
                form.reset();

                // 자동완성 Datalist 채우기
                const grades = [...new Set(['예과 1학년', '예과 2학년', '본과 1학년', '본과 2학년', '본과 3학년', '본과 4학년', ...this.getUniqueGrades()])];
                const subjects = [...new Set(['해부학', '생리학', '병리학', '약리학', '생화학', '미생물학', '순환기학', '호흡기학', ...this.questions.map(q => q.subject)])];
                const cohorts = [...new Set(['24학번 기출', '23학번 기출', '22학번 기출', '21학번 기출', '20학번 기출', ...this.questions.map(q => q.cohort)])];

                document.getElementById('gradeSuggestions').innerHTML = grades.map(g => `<option value="${this.escapeHtml(g)}">`).join('');
                document.getElementById('subjectSuggestions').innerHTML = subjects.map(s => `<option value="${this.escapeHtml(s)}">`).join('');
                document.getElementById('cohortSuggestions').innerHTML = cohorts.map(c => `<option value="${this.escapeHtml(c)}">`).join('');

                if (editId) {
                    const q = this.questions.find(item => item.id === editId);
                    if (!q) return;
                    document.getElementById('adminQuestionModalTitle').textContent = '기출문제 수정';
                    document.getElementById('qFormId').value = q.id;
                    document.getElementById('qFormGrade').value = q.grade;
                    document.getElementById('qFormSubject').value = q.subject;
                    document.getElementById('qFormCohort').value = q.cohort;
                    document.getElementById('qFormQuestion').value = q.question;
                    document.getElementById('qFormAnswer').value = q.answer;
                    document.getElementById('qFormOpt1').value = q.options[0] || '';
                    document.getElementById('qFormOpt2').value = q.options[1] || '';
                    document.getElementById('qFormOpt3').value = q.options[2] || '';
                    document.getElementById('qFormOpt4').value = q.options[3] || '';
                    document.getElementById('qFormOpt5').value = q.options[4] || '';
                    document.getElementById('qFormExplanation').value = q.explanation || '';
                } else {
                    document.getElementById('adminQuestionModalTitle').textContent = '새 기출문제 출제 등록';
                    document.getElementById('qFormId').value = '';
                    document.getElementById('qFormGrade').value = this.selectedGrade || '본과 1학년';
                    document.getElementById('qFormSubject').value = this.selectedSubject || '';
                    document.getElementById('qFormCohort').value = (this.selectedCohort && this.selectedCohort !== 'ALL') ? this.selectedCohort : '23학번 기출';
                }

                document.getElementById('adminQuestionModal').classList.remove('hidden');
            },

            closeAdminQuestionModal() {
                document.getElementById('adminQuestionModal').classList.add('hidden');
            },

            saveAdminQuestion(e) {
                e.preventDefault();
                if (!this.requireAdmin()) return;
                const id = document.getElementById('qFormId').value;
                const grade = document.getElementById('qFormGrade').value.trim();
                const subject = document.getElementById('qFormSubject').value.trim();
                const cohort = document.getElementById('qFormCohort').value.trim();
                const question = document.getElementById('qFormQuestion').value.trim();
                const answer = Number(document.getElementById('qFormAnswer').value);
                const options = [
                    document.getElementById('qFormOpt1').value.trim(),
                    document.getElementById('qFormOpt2').value.trim(),
                    document.getElementById('qFormOpt3').value.trim(),
                    document.getElementById('qFormOpt4').value.trim()
                ];
                const opt5 = document.getElementById('qFormOpt5').value.trim();
                if (opt5) options.push(opt5);
                const explanation = document.getElementById('qFormExplanation').value.trim();

                let targetObj = null;
                if (id) {
                    const idx = this.questions.findIndex(q => q.id === id);
                    if (idx !== -1) {
                        targetObj = { ...this.questions[idx], grade, subject, cohort, question, options, answer, explanation };
                        this.questions[idx] = targetObj;
                    }
                } else {
                    targetObj = {
                        id: 'q_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
                        grade,
                        subject,
                        cohort,
                        question,
                        options,
                        answer,
                        explanation
                    };
                    this.questions.push(targetObj);
                }

                this.saveQuestionsToLocal();
                if (targetObj) this.syncSingleQuestionToCloud(targetObj);

                this.selectedGrade = grade;
                this.selectedSubject = subject;
                this.selectedCohort = cohort;

                this.closeAdminQuestionModal();
                this.renderAll();
                this.showToast('기출문제가 성공적으로 저장되었습니다.', 'success');
            },

            confirmDeleteAdminQuestion(qId) {
                if (!this.requireAdmin()) return;
                this.openConfirmDialog(
                    '기출문제 삭제',
                    '이 문제를 기출 데이터베이스에서 삭제하시겠습니까?',
                    () => {
                        this.questions = this.questions.filter(q => q.id !== qId);
                        this.saveQuestionsToLocal();
                        this.deleteQuestionFromCloud(qId);
                        this.ensureDefaultHierarchySelection();
                        this.renderAll();
                        this.showToast('기출문제가 삭제되었습니다.', 'info');
                    }
                );
            },

            // ================= [JSON 대량 관리] =================
            openJsonManageModal() {
                if (!this.requireAdmin()) return;
                document.getElementById('jsonBulkTextarea').value = '';
                document.getElementById('jsonManageModal').classList.remove('hidden');
            },

            closeJsonManageModal() {
                document.getElementById('jsonManageModal').classList.add('hidden');
            },

            insertSampleJsonTemplate() {
                const template = [
                    {
                        grade: "본과 1학년",
                        subject: "해부학",
                        cohort: "24학번 기출",
                        question: "예시 기출문제 지문을 입력하세요.",
                        options: ["1번보기", "2번보기", "3번보기", "4번보기", "5번보기"],
                        answer: 1,
                        explanation: "정답에 대한 상세 해설을 입력하세요."
                    }
                ];
                document.getElementById('jsonBulkTextarea').value = JSON.stringify(template, null, 2);
            },

            exportQuestionsClipboard() {
                const text = JSON.stringify(this.questions, null, 2);
                const ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                try {
                    document.execCommand('copy');
                    this.showToast('전체 기출문제 JSON이 클립보드에 복사되었습니다.', 'success');
                } catch (e) {
                    this.showToast('복사 실패', 'error');
                }
                ta.remove();
            },

            exportQuestionsFile() {
                const text = JSON.stringify(this.questions, null, 2);
                const blob = new Blob([text], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `exam_questions_backup_${Date.now()}.json`;
                a.click();
                URL.revokeObjectURL(url);
                this.showToast('기출문제 JSON 파일이 다운로드되었습니다.', 'success');
            },

            importQuestionsFromJson(mode) {
                if (!this.requireAdmin()) return;
                const raw = document.getElementById('jsonBulkTextarea').value.trim();
                if (!raw) {
                    this.showToast('JSON 데이터를 입력해 주세요.', 'error');
                    return;
                }
                try {
                    const parsed = JSON.parse(raw);
                    if (!Array.isArray(parsed)) throw new Error('Root must be an array');

                    const formatted = parsed.map((item, idx) => ({
                        id: item.id || ('q_imported_' + Date.now() + '_' + idx),
                        grade: item.grade || '본과 1학년',
                        subject: item.subject || '기타과목',
                        cohort: item.cohort || '24학번 기출',
                        question: item.question || '무제',
                        options: Array.isArray(item.options) ? item.options : ['1', '2', '3', '4'],
                        answer: Number(item.answer || 1),
                        explanation: item.explanation || '해설 없음'
                    }));

                    if (mode === 'REPLACE') {
                        this.questions = formatted;
                    } else {
                        const existingIds = new Set(this.questions.map(q => q.id));
                        formatted.forEach(q => {
                            if (!existingIds.has(q.id)) {
                                this.questions.push(q);
                            }
                        });
                    }

                    this.saveQuestionsToLocal();
                    this.questions.forEach(q => this.syncSingleQuestionToCloud(q));

                    this.ensureDefaultHierarchySelection();
                    this.closeJsonManageModal();
                    this.renderAll();
                    this.showToast(`총 ${formatted.length}개 기출문제 등록이 완료되었습니다!`, 'success');
                } catch (e) {
                    this.showToast('JSON 파싱 오류: 올바른 배열 형식인지 확인해 주세요.', 'error');
                }
            },

            // ================= [사용자 로그인 & 관리자 승인 체크 & admin 로그인] =================
            loginFromGate(e) {
                e.preventDefault();
                const rawUid = document.getElementById('gateUserIdInput').value.trim();
                const uid = rawUid.replace(/[^a-zA-Z0-9_@.-]/g, '_');
                if (!uid) return;

                // 1. 관리자 아이디로 로그인 시도한 경우 -> 비밀번호(해시) 검증 후 관리자 페이지로 직행
                if (isAdminId(rawUid)) {
                    const passInput = document.getElementById('gateAdminPasswordInput');
                    const inputPass = passInput.value;
                    if (!inputPass || sha256Hex(inputPass) !== this.getAdminPasswordHash()) {
                        passInput.value = '';
                        this.showToast('아이디 또는 비밀번호가 올바르지 않습니다.', 'error');
                        return;
                    }
                    this.completeAdminLogin();
                    return;
                }

                // 2. 일반 사용자 로그인 시도 -> 이름 확인 및 관리자 승인 여부 검사
                const name = document.getElementById('gateUserNameInput').value.trim();
                if (!name) {
                    this.showToast('이름(실명 또는 닉네임)을 입력해 주세요.', 'error');
                    document.getElementById('gateUserNameInput').focus();
                    return;
                }

                this.attemptGeneralUserLogin(uid, name, 'CUSTOM_ID');
            },

            quickLogin(uid, name) {
                if (!uid || isAdminId(uid)) return;
                document.getElementById('gateUserIdInput').value = uid;
                document.getElementById('gateUserNameInput').value = name || '';
                this.onGateIdInputChange(uid);
                this.attemptGeneralUserLogin(uid, name || uid, 'CUSTOM_ID');
            },

            completeAdminLogin() {
                const adminObj = {
                    uid: ADMIN_ID,
                    name: '총괄 관리자',
                    isAdmin: true,
                    authType: 'ADMIN'
                };
                this.currentUser = adminObj;
                this.isAdminUnlocked = true;
                try { sessionStorage.setItem(STORAGE_KEYS.ADMIN_SESSION, this.makeAdminSessionToken()); } catch (e) {}
                this.saveProgressToLocal();
                document.getElementById('pendingNoticeBox').classList.add('hidden');
                document.getElementById('gateAdminPasswordInput').value = '';
                document.getElementById('gateUserIdInput').value = '';
                this.onGateIdInputChange('');

                // 관리자로 로그인하면 관리자 화면을 생성하고 즉시 메인으로 전환
                this.renderAll();
                this.switchMainTab('ADMIN');
                this.showToast('👑 관리자 계정으로 로그인되었습니다.', 'success');
                if (this.getAdminPasswordHash() === DEFAULT_ADMIN_PASSWORD_HASH) {
                    setTimeout(() => this.showToast('⚠️ 초기 비밀번호를 사용 중입니다. [관리자 비밀번호 변경]으로 바꿔 주세요.', 'error'), 600);
                }
            },

            attemptGeneralUserLogin(uid, name, authType = 'CUSTOM_ID') {
                if (isAdminId(uid)) return;
                const existing = this.userRegistryMap[uid];
                const noticeBox = document.getElementById('pendingNoticeBox');
                const noticeTitle = document.getElementById('pendingNoticeTitle');
                const noticeDesc = document.getElementById('pendingNoticeDesc');

                // 처음 로그인 시도하는 계정인 경우 -> PENDING(승인 대기)으로 등록 후 진입 차단
                if (!existing) {
                    const newAccount = {
                        uid,
                        name,
                        status: 'PENDING',
                        authType,
                        requestedAt: Date.now(),
                        updatedAt: Date.now()
                    };
                    this.userRegistryMap[uid] = newAccount;
                    this.saveUserRegistryToLocal();
                    this.syncUserAccountToCloud(newAccount);
                    this.addRecentUser({ uid, name });
                    this.renderAuthGate();

                    noticeBox.classList.remove('hidden');
                    noticeTitle.textContent = `[${name} (${uid})] 님의 가입 승인 요청이 접수되었습니다!`;
                    noticeDesc.innerHTML = `현재 <b>관리자 승인 대기 중</b>입니다. 관리자가 승인하면 바로 접속하실 수 있습니다.`;
                    this.showToast('관리자에게 로그인 승인 요청이 전송되었습니다.', 'info');
                    return;
                }

                // 이름은 최신 입력값으로 업데이트
                if (name && existing.name !== name) {
                    existing.name = name;
                    this.saveUserRegistryToLocal();
                    this.syncUserAccountToCloud(existing);
                }
                this.addRecentUser({ uid, name: existing.name });

                // 아직 PENDING 또는 REJECTED 상태인 경우 진입 차단
                if (existing.status !== 'APPROVED') {
                    this.renderAuthGate();
                    noticeBox.classList.remove('hidden');
                    noticeTitle.textContent = `[${existing.name} (${uid})] 계정은 아직 관리자 승인 대기 중입니다.`;
                    noticeDesc.innerHTML = `관리자 승인이 완료되면 같은 학번/아이디로 다시 로그인해 주세요.`;
                    this.showToast('관리자 승인이 완료된 후에 로그인할 수 있습니다.', 'error');
                    return;
                }

                // 승인 완료('APPROVED')된 사용자만 로그인 성공
                noticeBox.classList.add('hidden');
                this.currentUser = {
                    uid,
                    name: existing.name,
                    isAdmin: false,
                    authType
                };
                this.isAdminUnlocked = false;
                this.saveProgressToLocal();
                this.loadCurrentUserProgressFromCloud();

                // 일반 사용자는 오직 학습자 대시보드만 표시 (관리자 화면은 DOM에 존재하지 않음)
                this.unmountAdminUI();
                this.setViewVisible('quizSolveView', false);
                this.setViewVisible('userDashboardView', true);

                this.renderAll();
                this.showToast(`환영합니다, ${existing.name}님! 기출 학습을 시작하세요.`, 'success');
            },

            logout(customMsg = null) {
                const prevName = this.currentUser ? this.currentUser.name : '';
                this.currentUser = null;
                this.isAdminUnlocked = false;
                try { sessionStorage.removeItem(STORAGE_KEYS.ADMIN_SESSION); } catch (e) {}
                this.unmountAdminUI();
                this.setViewVisible('quizSolveView', false);
                this.setViewVisible('userDashboardView', true);
                this.saveProgressToLocal();
                this.renderAll();
                window.scrollTo({ top: 0, behavior: 'smooth' });
                this.showToast(customMsg || `${prevName} 계정이 로그아웃되었습니다.`, 'info');
            },

            async loginWithGoogle() {
                if (!this.fbAuth) {
                    this.showToast('Firebase 설정이 연결되지 않은 환경입니다. 학번과 이름을 입력해 가입 승인을 요청해 주세요.', 'info');
                    return;
                }
                try {
                    const provider = new GoogleAuthProvider();
                    const res = await signInWithPopup(this.fbAuth, provider);
                    if (res.user) {
                        this.attemptGeneralUserLogin(
                            res.user.uid,
                            res.user.displayName || res.user.email || 'Google 학습자',
                            'GOOGLE'
                        );
                    }
                } catch (e) {
                    this.showToast('팝업 환경 제한으로 Google 로그인이 취소되었습니다. 학번/이름 로그인을 이용해 주세요.', 'info');
                }
            },

            confirmResetUserProgress() {
                this.openConfirmDialog(
                    '내 풀이 기록 초기화',
                    `${this.currentUser.name} 님의 개인 문제 풀이 기록과 오답노트만 초기화됩니다. (다른 사용자나 등록된 기출문제는 유지됨)`,
                    () => {
                        this.allUsersProgressMap[this.currentUser.uid] = {};
                        this.saveProgressToLocal();
                        this.syncUserProgressToCloud();
                        this.renderAll();
                        this.showToast('나의 풀이 기록이 초기화되었습니다.', 'info');
                    }
                );
            },

            // ================= [Firebase Config 모달 & 공통 유틸] =================
            openFirebaseConfigModal() {
                if (!this.requireAdmin()) return;
                const saved = localStorage.getItem(STORAGE_KEYS.CUSTOM_FB) || '';
                document.getElementById('customFirebaseConfigInput').value = saved;
                document.getElementById('firebaseConfigModal').classList.remove('hidden');
            },

            closeFirebaseConfigModal() {
                document.getElementById('firebaseConfigModal').classList.add('hidden');
            },

            saveCustomFirebaseConfig() {
                if (!this.requireAdmin()) return;
                const raw = document.getElementById('customFirebaseConfigInput').value.trim();
                if (!raw) {
                    localStorage.removeItem(STORAGE_KEYS.CUSTOM_FB);
                    this.closeFirebaseConfigModal();
                    this.showToast('커스텀 클라우드 설정이 해제되었습니다.', 'info');
                    return;
                }
                try {
                    const parsed = JSON.parse(raw);
                    if (!parsed.apiKey) throw new Error('apiKey 누락');
                    localStorage.setItem(STORAGE_KEYS.CUSTOM_FB, JSON.stringify(parsed));
                    this.closeFirebaseConfigModal();
                    this.showToast('Firebase 설정이 저장되었습니다. 적용을 위해 새로고침합니다.', 'success');
                    setTimeout(() => location.reload(), 900);
                } catch (e) {
                    this.showToast('유효한 JSON 형식의 Firebase Config를 입력해 주세요.', 'error');
                }
            },

            openConfirmDialog(title, desc, onOk, showPrompt = false) {
                document.getElementById('confirmDialogTitle').textContent = title;
                document.getElementById('confirmDialogDesc').textContent = desc;
                const promptWrap = document.getElementById('confirmPromptWrapper');
                const promptInput = document.getElementById('confirmPromptInput');

                if (showPrompt) {
                    promptWrap.classList.remove('hidden');
                    promptInput.value = '';
                } else {
                    promptWrap.classList.add('hidden');
                }

                document.getElementById('confirmDialogOkBtn').onclick = () => {
                    const val = promptInput.value;
                    this.closeConfirmDialog();
                    onOk(val);
                };
                document.getElementById('confirmDialogModal').classList.remove('hidden');
            },

            closeConfirmDialog() {
                document.getElementById('confirmDialogModal').classList.add('hidden');
            },

            showToast(msg, type = 'info') {
                const area = document.getElementById('toastArea');
                const el = document.createElement('div');
                let bg = 'bg-slate-900 text-white';
                if (type === 'success') bg = 'bg-emerald-600 text-white';
                if (type === 'error') bg = 'bg-rose-600 text-white';

                el.className = `${bg} px-4 py-3 rounded-xl shadow-lg text-xs sm:text-sm font-bold fade-in`;
                el.textContent = msg;
                area.appendChild(el);

                setTimeout(() => {
                    el.style.opacity = '0';
                    el.style.transition = 'opacity 0.25s ease';
                    setTimeout(() => el.remove(), 250);
                }, 2600);
            },

            escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }
        };

        window.app = app;
        window.onload = () => app.init();
    </script>
</body>
</html>
